POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agrops
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/agrops
SECRET_KEY=cambia-esto-por-un-secreto-largo
OLLAMA_API_KEY=ollama
RAG_GENERATION_MODEL=llama3.2:latest
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_MAX_TOKENS=1024
RAG_CHAT_MAX_TOKENS=256
RAG_NUM_CTX=2048
RAG_FINAL_K=3
RAG_RETRIEVAL_K=6
RAG_BM25_K=6
RAG_CANDIDATE_K=8
RAG_USE_QUERY_REWRITE=false
RAG_AGENT_FAST=true
RAG_AGENT_MAX_REWRITES=0
# Retrieve del chat: hybrid_rrf (rápido) vs hybrid_expansion_rrf (más recall).
RAG_CHAT_FAST_RETRIEVAL=true
# Solo embedding+pgvector (salta BM25/RRF). Máxima velocidad de retrieve.
RAG_CHAT_DENSE_ONLY=false
# Generación corta + prompt compacto en estrategias rápidas del chat.
RAG_CHAT_FAST_GEN=true
RAG_CHAT_CHUNK_CHAR_LIMIT=600
RAG_RELATED_QUESTIONS=0
# Respuesta plantilla inmediata si no hay evidencia (sin llamar al LLM).
RAG_FAST_ABSTAIN=true
# Caché de embeddings de consulta (0 = off).
RAG_QUERY_EMBED_CACHE=256
RAG_RETRIEVAL_CACHE_TTL=180
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:5173
FRONTEND_HOST_PORT=80
DOCUMENT_STORAGE_ROOT=/app/uploads
RAG_USE_RERANKER=false
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
RAG_EMBED_BATCH_SIZE=64
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=120
EMBEDDING_INDEXER_ENABLED=true
EMBEDDING_BATCH_SIZE=20
EMBEDDING_INDEXER_INTERVAL=20
EMBEDDING_LEASE_MINUTES=15
RAG_CHUNK_CHAR_LIMIT=1000
RAG_AGENT_CHUNK_CHARS=600
RAG_AGENT_CHUNK_N=3
RAG_PDF_OCR=true
RAG_PDF_MAX_PAGES=120
RAG_PDF_OCR_SCALE=2
DOCKERHUB_USER=samuelzo
IMAGE_TAG=latest
RAG_WHISPER_MODEL=tiny
RAG_WHISPER_DEVICE=cpu
RAG_WHISPER_LANGUAGE=es
# Inferencia automática: warm-up embed+LLM al arrancar el gateway.
RAG_INFERENCE_WARMUP=true
RAG_INFERENCE_WARMUP_TIMEOUT=180
OLLAMA_NUM_GPU=1
OLLAMA_FLASH_ATTENTION=1
# MCP (Cursor, proceso en el host; no van en mcp.json).
AGROPS_BASE_URL=http://localhost:8000
AGROPS_MCP_EMAIL=
AGROPS_MCP_PASSWORD=
# AGROPS_MCP_TOKEN=
MCP_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/agrops
