{
  "mcpServers": {
    "agrops": {
      "type": "stdio",
      "command": "python",
      "args": ["${workspaceFolder}/mcp_servers/agrops_gateway.py"],
      "env": {
        "AGROPS_BASE_URL": "http://localhost:8000"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "agrops-postgres": {
      "type": "stdio",
      "command": "python",
      "args": ["${workspaceFolder}/mcp_servers/agrops_postgres.py"],
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
